# ==============================================================================
# Mandarin Reactor — Configuración opcional del Backend
# Copiá este archivo como `.env` dentro de `apps/api/` si querés personalizarlo.
# Todos los valores tienen defaults listos para funcionar sin crear un `.env`.
# ==============================================================================

# Directorio donde se guardan la base SQLite (`app.db`), videos, clips y CC-CEDICT
# DATA_DIR=./data

# Orígenes permitidos por CORS (separados por coma o lista JSON)
CORS_ORIGINS=http://localhost:5173

# Margen por defecto (en milisegundos) al cortar clips de video/audio (±300 ms)
DEFAULT_CLIP_PAD_MS=300

# Aplicar reglas de tone sandhi (变调) al generar pinyin con pypinyin
PINYIN_TONE_SANDHI=false

# Rutas opcionales a diccionarios personalizados para jieba / pypinyin
# USERDICT_PATH=./data/userdict.txt
# PINYIN_OVERRIDES_PATH=./data/pinyin_overrides.json

# Diccionario CC-CEDICT (se descarga automáticamente si se solicita desde la UI o CLI)
# CEDICT_PATH=./data/cedict_ts.u8
# CEDICT_DOWNLOAD_URL=https://www.mdbg.net/chinese/export/cedict/cedict_1_0_ts_utf-8_mdbg.txt.gz

# Traducción automática opcional vía API externa (compatible con LibreTranslate).
# Si no se configura, se usa la glosa offline palabra por palabra con CC-CEDICT.
# TRANSLATION_API_URL=http://localhost:5000/translate
# TRANSLATION_API_KEY=
